{
  "name": "stream-resolver",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/goat/vendor','dist/goat/vendor',{recursive:true})\" && node -e \"require('fs').cpSync('src/client','dist/client',{recursive:true})\"",
    "start": "node dist/server/main.js",
    "dev": "npm run build && node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "happy-dom": "^20.14.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
